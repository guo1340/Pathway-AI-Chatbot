# choose your LLM provider: openai | ollama
LLM_PROVIDER=openai

# --- if LLM_PROVIDER=openai ---
OPENAI_API_KEY="sk-<OPEN_API_KEY>"
# optional; default gpt-4o-mini (cheap) or gpt-4o for better quality
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- if LLM_PROVIDER=ollama ---
# make sure `ollama serve` is running locally, e.g. `ollama run llama3.1`
OLLAMA_MODEL=llama3.1
# tip: for embeddings with ollama you can use "nomic-embed-text" pulled via ollama

# server + rag settings
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DOCS_DIR=./docs
CHROMA_DIR=./chroma_store
# JWTs for normal Ask AI access must include JWT_REQUIRED_CAP.
# edit_posts matches the current Contributor-or-higher Ask AI access.
JWT_REQUIRED_CAP=edit_posts
# Upload and reload JWTs must include both JWT_REQUIRED_CAP and JWT_DASHBOARD_CAP.
JWT_DASHBOARD_CAP=manage_rag
CHAT_QUERY_MAX_LENGTH=4000
# Estimated UTF-8 input tokens across the question and six recent messages.
CHAT_INPUT_TOKEN_LIMIT=2000
# Hard response-generation ceiling passed to the configured LLM.
LLM_MAX_OUTPUT_TOKENS=1200
# Durable daily budget per stable JWT user identity.
CHAT_DAILY_TOKEN_LIMIT=100000
# First non-empty claim is used as the stable quota key.
JWT_USER_ID_CLAIMS=sub,user_id,id
# Durable SQLite quota database shared by workers on one server.
TOKEN_USAGE_DB=./data/token_usage.sqlite3
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# Enable only when requests arrive through a trusted proxy that overwrites X-Forwarded-For.
CHAT_TRUST_PROXY=false
# Durable raw exchanges visible to the authenticated user before older turns are summarized.
CHAT_VISIBLE_EXCHANGES=12
# Recent raw messages included with the private cumulative summary for each answer.
CHAT_SERVER_HISTORY_MESSAGES=24
# Short-lived, filename-scoped citation link lifetime. Full chat JWTs are never placed in file URLs.
FILE_TICKET_TTL_SECONDS=900
# CHUNK_SIZE remains supported as a fallback for CHUNK_MAX_SIZE.
CHUNK_MIN_SIZE=200
CHUNK_MAX_SIZE=1000
CHUNK_OVERLAP=200
# OCR is used only for PDF pages with little or no embedded text.
PDF_OCR_ENABLED=true
# auto prefers Tesseract and falls back to bundled RapidOCR.
PDF_OCR_ENGINE=auto
PDF_OCR_MIN_TEXT_CHARS=40
PDF_OCR_DPI=200
PDF_OCR_LANGUAGE=eng
# Optional Windows example when tesseract.exe is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TOP_K=4
TEMPERATURE=0.2

CHROMA_DISABLE_TELEMETRY=1
